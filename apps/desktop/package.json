{
	"name": "@facet/desktop",
	"version": "0.1.0",
	"description": "Facet 是 pi 编码助手的桌面端：主机与界面分进程，可以连本机也可以连远程。",
	"homepage": "https://github.com/kuraxii/facet",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/kuraxii/facet.git"
	},
	"author": {
		"name": "Facet",
		"email": "facet@localhost"
	},
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"predev": "node ../../scripts/ensure-electron.mjs",
		"dev": "electron-vite dev",
		"prestart": "node ../../scripts/ensure-electron.mjs",
		"start": "electron-vite preview",
		"build": "electron-vite build",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run --passWithNoTests",
		"dist": "npm run build && electron-builder"
	},
	"dependencies": {
		"node-pty": "^1.1.0",
		"ssh2": "^1.17.0",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.2.1",
		"@facet/agent": "*",
		"@facet/client-core": "*",
		"@facet/protocol": "*",
		"@facet/server": "*",
		"@facet/services": "*",
		"@facet/transport": "*",
		"@facet/ui": "*",
		"@facet/ui-editor": "*",
		"@facet/ui-terminal": "*",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/ssh2": "^1.15.6",
		"@vitejs/plugin-react": "^5.1.1",
		"electron": "45.2.3",
		"electron-builder": "^26.18.1",
		"electron-vite": "^6.0.0",
		"lucide-react": "^1.72.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	},
	"desktopName": "facet.desktop"
}
